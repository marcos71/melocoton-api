{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API for a ceramics workshop. Business errors use { \"error\": { \"code\", \"message\" } } with a Spanish message.",
    "title" : "Melocotón API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            },
            "description" : "Logged in"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "invalid_credentials, whatever the reason (DI-30)"
          }
        },
        "summary" : "Log in with email and password (CU-01)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/password-reset-requests" : {
      "post" : {
        "description" : "Always 202, whether or not the email exists or a link was sent (DI-33).",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Ask for a link to define a new password; also resends an invitation (CU-01 2c)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "New token"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "not_authenticated: the session expired or is no longer valid"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Renew the session token, so it expires 30 days after the last use (DI-28)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/session" : {
      "get" : {
        "operationId" : "session",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "The session's user"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "not_authenticated"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Who is logged in, to build the navigation for the role (RF-02)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/set-password" : {
      "post" : {
        "operationId" : "setPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password defined; every open session is closed"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "link_expired (expired, already used or inactive account); validation_error (the password must have 10 to 128 characters)"
          }
        },
        "summary" : "Define the password from an invitation or reset link (CU-01 2c, 2e)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "Everything is up"
          },
          "503" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "Something is down; the body says what"
          }
        },
        "summary" : "Whether the API and its database are working",
        "tags" : [ "Health" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ErrorBody" : {
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stable identifier in English, for the client"
          },
          "message" : {
            "type" : "string",
            "description" : "Text for the person, in Spanish"
          }
        },
        "required" : [ "code", "message" ]
      },
      "ErrorResponse" : {
        "properties" : {
          "error" : {
            "$ref" : "#/components/schemas/ErrorBody"
          }
        },
        "required" : [ "error" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "database" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          }
        },
        "required" : [ "database", "status" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "LoginResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "user" : {
            "$ref" : "#/components/schemas/SessionUserResponse"
          }
        },
        "required" : [ "accessToken", "expiresAt", "user" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "user" : {
            "$ref" : "#/components/schemas/SessionUserResponse"
          }
        },
        "required" : [ "user" ]
      },
      "SessionUserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "STUDENT", "LEAD_TEACHER", "ASSISTANT_TEACHER" ]
          }
        },
        "required" : [ "id", "name", "role" ]
      },
      "SetPasswordRequest" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "accessToken", "expiresAt" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
