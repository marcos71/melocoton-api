# Copy this file to .env and fill in the values. Never commit .env.
# The API reads these variables from the environment (DI-19).

# Development database
DB_URL=jdbc:postgresql://localhost:5432/melocoton_dev

# Test database: recreated by Flyway before every test run
TEST_DB_URL=jdbc:postgresql://localhost:5432/melocoton_test

# Owner role: runs Flyway migrations (creates and alters tables)
DB_OWNER_USER=melocoton_owner
DB_OWNER_PASSWORD=

# Application role: used by the API for every query (DI-05)
DB_APP_USER=melocoton_app
DB_APP_PASSWORD=

# Allowed CORS origin (the PWA in development)
CORS_ALLOWED_ORIGIN=http://localhost:5173
